# Copy these settings into .env for local development.
# Replace the secret with a long, random value before running the API.
CIVICFIX_SECRET_KEY=change-this-secret-key
CIVICFIX_TOKEN_MINUTES=1440
CIVICFIX_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: set both to create the first admin account on startup.
# Do not use weak or example credentials.
# CIVICFIX_ADMIN_EMAIL=
# CIVICFIX_ADMIN_PASSWORD=
# CIVICFIX_ADMIN_NAME=CivicFix Admin

# AI category suggestion helper (Google AI Studio key, free tier).
# Leaves the manual category untouched; the suggestion endpoint only hints.
# CIVICFIX_GEMINI_API_KEY=
# CIVICFIX_GEMINI_MODEL=gemini-2.0-flash
# CIVICFIX_LLM_ENABLED=true

# OTP email delivery for password reset + email verification (SMTP).
# Examples: Brevo smtp-relay.brevo.com:587, Gmail smtp.gmail.com:465 (app password).
# When unset, both OTP endpoints work in dev mode and return the code.
# CIVICFIX_SMTP_HOST=
# CIVICFIX_SMTP_PORT=587
# CIVICFIX_SMTP_USER=
# CIVICFIX_SMTP_PASSWORD=
# CIVICFIX_SMTP_FROM=
# CIVICFIX_BRAND=CivicFix
